package matrix;
import java.util.Scanner;

public class Multiplication_of_matrix {

	public static void main(String[] args) {

		Scanner s = new Scanner(System.in);
		int r1,c1,r2,c2;
		
		System.out.println("Enter rows in matrix A: ");
		r1 = s.nextInt();
		System.out.println("Enter column in matrix A: ");
		c1 = s.nextInt();
		
		int A[][] = new int[r1][c1];
		
		System.out.println("Enter rows in matrix B: ");
		r2 = s.nextInt();
		System.out.println("Enter column in matrix B: ");
		c2 = s.nextInt();
		
		int B[][] = new int[r2][c2];
		int C[][] = new int[r1][c2];
		
		if (c1 != r2) {
			System.out.println("Invalid matrix multiplication");
			return;
		}
		
		System.out.println("Enter elements of matrix A: ");
		for(int i = 0; i<r1; i++) {
			for (int j = 0 ; j<c1; j++) {
				A[i][j] = s.nextInt(); 
			}
		}
		System.out.println("Enter elements of matrix B: ");
		for(int i = 0; i<r2; i++) {
			for (int j = 0 ; j<c2; j++) {
				B[i][j] = s.nextInt(); 
			}
		}
		for(int i = 0; i< r1; i++) {
			for (int j = 0 ; j< c2; j++) {
				for (int k = 0; k<c1 ; k++) {
					C[i][j] += A[i][k] * B[k][j]; 
				}
			}
		}
		
		System.out.println(" matrix multiplication of A & B : ");
		for(int i = 0; i<r1; i++) {
			for (int j = 0 ; j<c2; j++) {
				System.out.print(C[i][j]+ " ");
			}
			System.out.println();
		}
		
	}

}
